{{systemLog 'HEALTH | ' this}}

{{#cp2020-sectionBox title='Health' class='edgerunner-sheet__health'}}
  <article class="health__damage-interface">
    {{cp2020-mannequin
      action="health-click"
      class="health__mannequin"
      locationClasses=health.locationClasses
      graphic=graphic
    }}
    {{cp2020-progressDetail
      class="health__detail"
      value=health.statusLevel
      max=40
      name=(concat (localize (concat @root.constants.SYSTEM_NAME '.health.condition.label')) ': ' health.condition)
    }}
    <div class="health__save-interface">
      {{save
        label=(localize (concat @root.constants.SYSTEM_NAME '.health.saves.stun'))
        name='stun'
        saveFormula=(concat '1d10cs<' health.stunSave)
        value=health.stunSave
      }}
      {{save
        label=(localize (concat @root.constants.SYSTEM_NAME '.health.saves.death'))
        name='death'
        saveFormula=(concat '1d10cs<' health.deathSave)
        value=health.deathSave
      }}
    </div>
  </article>
{{/cp2020-sectionBox}}
