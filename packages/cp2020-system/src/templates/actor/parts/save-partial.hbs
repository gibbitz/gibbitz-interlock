{{#cp2020-fieldBox
  class=(concat 'edgerunner__stat--level-' value)
}}
  <article class="edgerunner__save--inner">
    <button
      data-flavor="[{{localize (concat @root.constants.SYSTEM_NAME '.stats.flavor.save')}}] {{name}}"
      data-roll-formula="{{saveFormula}}"
      data-selector="stat-roll"
      class="stat__roll die--d-10 die--d-10--save">
    </button>
    {{cp2020-progressDetail
      class=(concat name '-save__progress ' @root.constants.SYSTEM_NAME '__save-box')
      value=value
      max=10
      name=label
    }}
  </article>
{{/cp2020-fieldBox}}
