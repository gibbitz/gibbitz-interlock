<div class="edgerunner-sheet__combat-grid">
  {{systemLog ' COMBAT LAYOUT PARTIAL | ' this}}
  {{stat combatStats}}

  {{health
    health=health
    graphic=graphic
  }}
  {{!-- equiped --}}
  {{itemList
    items=weapon
    class='combat-grid__weapons combat-grid__weapons--equiped'
    title='Equiped Weapons'
  }}
  {{!-- cyberweapons --}}
  {{armor
    armor=armor
    graphic=graphic
    locationClasses=armorLocationClasses
  }}
  {{!-- stashed --}}
  {{itemList
    items=weapon
    class='combat-grid__weapons combat-grid__weapons--all'
    title='All Weapons'
  }}
</div>