<label
  class="cp2020-progress-detail
  {{#if class}}{{class}}-label{{/if}}"
>
  <value>
    <em>{{value}}</em>{{#if max}}/{{max}}{{/if}}
  </value>
    {{cp2020-progress
      value=value
      max=max
      min=min
      class=(concat class '__value')
    }}
  <small>
    {{name}}
  </small>
</label>