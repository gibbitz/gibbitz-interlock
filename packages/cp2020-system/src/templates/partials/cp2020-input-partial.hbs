{{#ifEquals type 'hidden'}}

  <input
    name="{{name}}"
    value="{{value}}"
    type="{{type}}"
    data-selector="{{selector}}"
    data-uuid="{{uuid}}"
    data-key="{{key}}"
    data-meta="{{meta}}"
    data-render="{{render}}"
  />

{{else}}

  {{#cp2020-fieldBox class=class}}
      <label>
        {{#if disabled}}
          <output
            name="{{name}}"
            type="{{type}}"
            data-selector="{{selector}}"
            data-uuid="{{uuid}}"
            data-key="{{key}}"
            data-meta="{{meta}}"
            data-render="{{render}}"
          >{{value}}</output>
        {{else}}
          <input
            name="{{name}}"
            value="{{value}}"
            type="{{type}}"
            data-selector="{{selector}}"
            data-uuid="{{uuid}}"
            data-key="{{key}}"
            data-meta="{{meta}}"
            data-render="{{render}}"
          />
        {{/if}}
        <small>{{localize label}}</small>
      </label>
  {{/cp2020-fieldBox}}

{{/ifEquals}}