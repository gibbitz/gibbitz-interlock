{{systemLog ' ARMOR SHEET | ' this}}
<form autocomplete="off" class="system-{{@root.constants.SYSTEM_NAME}}__armor-sheet crt {{cssClass}}">
  {{cp2020-outfitHeader
    name=item.name
    label=(concat @root.constants.SYSTEM_NAME '.items.armor.label')
  }}

  <nav class="sheet-tabs tabs" data-selector="primary-tabs" data-group="primary">
    <a class="item" data-tab="description">Details</a>
    <a class="item" data-tab="locations">Locations</a>
  </nav>
  {{!-- Sheet Body --}}
  <section data-selector="primary-tab-body">

    <article class="tab armor-sheet__details" data-group="primary" data-tab="description">
      <div class="armor-sheet__details--layout">
      <figure class="item-details__image">
        <img class="item-details__graphic" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
      </figure>
      {{cp2020-input
        class="item-details__name"
        label=(concat @root.constants.SYSTEM_NAME '.items.name')
        name="name"
        type='text'
        value=item.name
      }}
      {{cp2020-input
        label=(concat @root.constants.SYSTEM_NAME '.items.armor.ev.long')
        name="system.ev"
        type='number'
        value=item.system.ev
      }}
      {{outfitSpecs this}}
      {{cp2020-editor
        class="item-details__description"
        target="system.description"
        engine="prosemirror"
      }}
      </div>
    </article>

    <article class="armor-sheet__locations tab" data-group="primary" data-tab="locations">
      <div class="armor-sheet__locations--layout">
        {{cp2020-mannequin
          class="locations__mannequin"
          locationClasses=locationClasses
          graphic=graphic
        }}
        {{#cp2020-sectionBox title='locations' class='locations__details'}}
          <ul
            class="locations__details-list"
            data-selector="location-detail"
          >
            {{#each item.system.locations}}
              {{systemLog ' ARMOR LOCATION | ' this}}
              <li class="locations__details-location">
                {{cp2020-input
                  name=(concat 'system.locations.' @index '.location')
                  value=location
                  disabled=true
                  type='text'
                  label=(concat @root.constants.SYSTEM_NAME '.items.armor.locations.location.long')
                }}
                {{cp2020-input
                  name=(concat 'system.locations.' @index '.total')
                  disabled=true
                  value=total
                  type='number'
                  label=(concat @root.constants.SYSTEM_NAME '.items.armor.locations.total.short')
                }}
                {{cp2020-input
                  name=(concat 'system.locations.' @index '.sp')
                  value=sp
                  type='number'
                  label=(concat @root.constants.SYSTEM_NAME '.items.armor.locations.sp.short')
                }}
                {{cp2020-input
                  name=(concat 'system.locations.' @index '.ablation')
                  value=ablation
                  type='number'
                  label=(concat @root.constants.SYSTEM_NAME '.items.armor.locations.ab.long')
                }}
                {{cp2020-button
                  label=(concat @root.constants.SYSTEM_NAME '.items.armor.locations.remove.long')
                  action='delete-location'
                  key=@index
                }}

              </li>
            {{/each}}
          </ul>
        {{/cp2020-sectionBox}}
      </div>
    </article>
  </section>
</form>