{{systemLog ' SKILLSHEET PARTIAL | ' this }}
<form class="{{cssClass}} skill-sheet" autocomplete="off">
  {{#if (eq item.type 'Chipware')}}
      {{cp2020-outfitHeader
        name=item.name
        label=(concat @root.constants.SYSTEM_NAME '.items.chipware.label')
      }}
  {{else}}
    {{cp2020-outfitHeader
      name=item.name
      label=(concat @root.constants.SYSTEM_NAME '.items.skill.label')
    }}
  {{/if}}
  <section class="item-sheet fieldset">
    {{#unless (eq item.type 'Chipware')}}
      {{#if (eq item.parent.type 'Edgerunner')}}
        {{!-- Sheet Tab Navigation --}}
        <nav class="sheet-tabs tabs legend" data-selector="primary-tabs" data-group="primary">
          <a class="sheet-tab" data-tab="description">Description</a>
          <a class="sheet-tab" data-tab="details">Details</a>
        </nav>
      {{/if}}
    {{/unless}}

    {{!-- Sheet Body --}}
    <section data-selector="primary-tab-body">

      {{!-- Description Tab --}}
      <article
        {{#unless (eq item.type 'Chipware')}}
          {{#if (eq item.parent.type 'Edgerunner')}}
            class="tab"
          {{/if}}
        {{/unless}}
        data-group="primary"
        data-tab="description"
      >
        <div class="item-sheet__description">
          <div class="item-sheet__name-ip">
          {{cp2020-input
            label=(concat @root.constants.SYSTEM_NAME '.items.skill.nameLabel')
            name="name"
            type='text'
            value=item.name
          }}
          {{#unless (eq item.type 'Chipware')}}
              {{cp2020-input
                label=(concat @root.constants.SYSTEM_NAME '.items.skill.ipMultiplier')
                name="system.ipMultiplier"
                type='number'
                value=item.system.ipMultiplier
              }}
          {{/unless}}
          </div>
          <div class="item-sheet__core-stats">
            {{cp2020-select
              label=(concat @root.constants.SYSTEM_NAME '.items.skill.stat')
              name="system.stat"
              value=item.system.stat
              options=@root.constants.STAT_SELECT_OPTIONS
            }}
            {{#if (eq item.type 'Chipware')}}
              {{cp2020-input
                label=(concat @root.constants.SYSTEM_NAME '.items.skill.level')
                name="level"
                type='number'
                value=item.level
              }}
            {{else}}
              {{cp2020-select
                label=(concat @root.constants.SYSTEM_NAME '.items.skill.specialAbility')
                name="system.specialAbility"
                value=item.system.specialAbility
                options=roles
              }}
            {{/if}}
          </div>
          {{cp2020-editor
            content=item.system.description
            editable='true'
            label=(concat @root.constants.SYSTEM_NAME '.items.skill.description')
            target="system.description"
            engine="prosemirror"
          }}
        </div>
      </article>

      {{!-- Details Tab --}}
      {{#unless (eq item.type 'Chipware')}}
        {{#if (eq item.parent.type 'Edgerunner')}}
          <article
            class="tab details"
            data-group="primary"
            data-tab="details"
          >
            <div class="item-sheet__details">
              <div class="item-sheet__roll-formula">
                <value class="item-sheet__roll-formula--value">
                  {{rollData.rollFormula}}
                </value>
                <label>{{localize (concat @root.constants.SYSTEM_NAME '.items.skill.formula')}}</label>
              </div>
              <div class="item-sheet__detail-stats">
                {{cp2020-input
                  label=(concat @root.constants.SYSTEM_NAME '.items.skill.level')
                  name="system.level"
                  type='number'
                  value=item.system.level
                }}
                {{cp2020-input
                  label=(concat @root.constants.SYSTEM_NAME '.items.skill.ip')
                  name="system.ip"
                  type='number'
                  value=item.system.ip
                }}
                <div class="item-sheet__skill-level-up">
                  <value class="item-sheet__skill-level-up--value">
                    {{system.levelUp}}
                  </value>
                  <label>{{localize (concat @root.constants.SYSTEM_NAME '.items.skill.levelUp')}}</label>
                </div>
              </div>
                {{cp2020-textarea
                  label=(concat @root.constants.SYSTEM_NAME '.items.skill.notes')
                  name="item.system.notes"
                  value=item.system.notes
                }}
            </div>
          </article>
        {{/if}}
      {{/unless}}
    </section>
  </section>
</form>