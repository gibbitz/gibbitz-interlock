{{cp2020-input
  class="item-details__name"
  label=(concat @root.constants.SYSTEM_NAME '.items.name')
  name="name"
  type='text'
  value=item.name
}}
{{#unless ignoreImage}}
  <img
    class="item-details__image"
    src="{{item.img}}"
    data-edit="img"
    title="{{item.name}}"
  />
{{/unless}}
{{cp2020-editor
  content=system.description
  class="item-details__description"
  target="system.description"
  engine="prosemirror"
}}
