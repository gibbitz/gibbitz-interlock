{{#if isOwned}}
  {{cp2020-checkbox
    class="item-details__equipped"
    label=(concat @root.constants.SYSTEM_NAME '.items.equipped')
    name="system.equipped"
    value=item.system.equipped
  }}
{{/if}}
  {{cp2020-input
    class="item-details__weight"
    label=(concat @root.constants.SYSTEM_NAME '.items.weight')
    name="system.weight"
    type='number'
    value=item.system.weight
  }}
{{outfitEcon this}}