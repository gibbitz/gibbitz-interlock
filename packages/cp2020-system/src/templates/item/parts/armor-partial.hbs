{{systemLog ' ARMOR PARTIAL | ' this}}
{{#if this.length}}
  {{#cp2020-sectionBox
    title='Armor'
    class='item-list__wrapper'
  }}
    {{cp2020-mannequin
      class="locations__mannequin"
      locationClasses=locationClasses
      graphic=graphic
    }}
    <div class="item-list item-list--armor">
      {{#each this}}
        {{cp2020-progressDetail
          class="armor__local--bar"
          max=sp
          min=0
          value=ablation
          name=location
        }}
      {{/each}}
    </div>
  {{/cp2020-sectionBox}}
{{/if}}