{{systemLog ' ARMOR PARTIAL | ' armor }}
{{#if armor.length}}
  {{#cp2020-sectionBox
    title='Armor'
    class='item-list__wrapper'
  }}
    <article class="armor__ablation-interface">

    {{!-- this will need the classnames added dynamically --}}
    {{!-- mousing over items in the list on the right should highlight the areas --}}
      {{#cp2020-fieldBox
        class="mannequin-box"
      }}
        {{cp2020-mannequin
          class="armor__mannequin locations__mannequin"
          locationClasses=locationClasses
          graphic=graphic
        }}
      {{/cp2020-fieldBox}}
      <div class="item-list">
        {{!-- this section will need overall ablation indication --}}
        {{#each armor}}
          {{#cp2020-fieldBox}}
          <a
            data-selector="item-edit"
            data-uuid="{{_id}}"
            title="edit"
          >
            {{cp2020-progressDetail
              class="armor__local--bar"
              max=system.sp
              min=0
              value=system.total
              name=name
            }}
          </a>
          {{/cp2020-fieldBox}}
        {{/each}}
      </div>
    </article>
  {{/cp2020-sectionBox}}
{{/if}}